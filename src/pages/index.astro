---
const label = 'VESSYL';

// CHANGE THIS before publishing:
const demoEmail = 'yourrealemail@gmail.com';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <meta name="theme-color" content="#080808" />

    <meta
      name="description"
      content="VESSYL — A Place Where Sound Takes You. Independent electronic music label. Demo submissions now open."
    />

    <title>VESSYL — A Place Where Sound Takes You</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <style>
      :root {
        font-family: 'DM Sans', sans-serif;
        color: #f1efe9;
        background: #080808;
        font-synthesis: none;
      }

      * {
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        margin: 0;
        min-height: 100vh;
        background:
          radial-gradient(
            circle at 50% 20%,
            rgba(255, 255, 255, 0.07),
            transparent 35%
          ),
          radial-gradient(
            circle at 20% 80%,
            rgba(167, 140, 255, 0.035),
            transparent 28%
          ),
          #080808;
        overflow-x: hidden;
      }

      body::before {
        content: '';
        position: fixed;
        inset: 0;
        pointer-events: none;

        background:
          repeating-linear-gradient(
            90deg,
            transparent 0,
            transparent 118px,
            rgba(255, 255, 255, 0.018) 119px,
            rgba(255, 255, 255, 0.018) 120px
          );

        opacity: 0.7;
        z-index: 0;
      }

      a {
        color: inherit;
        text-decoration: none;
      }

      .page {
        position: relative;
        z-index: 1;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
      }

      .hero {
        min-height: calc(100vh - 70px);
        padding: 55px 24px 75px;

        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;

        text-align: center;
      }

      /* -----------------------------------
         LOGO
         Crops out the "MINIMAL TECH" line
      ----------------------------------- */

      .logo-window {
        width: min(690px, 92vw);
        aspect-ratio: 1.75 / 1;

        overflow: hidden;

        margin-bottom: 26px;

        animation: logoEnter 1.1s ease both;
      }

      .logo-window img {
        width: 100%;
        height: auto;
        display: block;

        /*
          Moves the original image upward.
          The container clips the bottom
          so "MINIMAL TECH" disappears.
        */
        transform: translateY(-14%);
      }

      @keyframes logoEnter {
        from {
          opacity: 0;
          transform: translateY(20px);
        }

        to {
          opacity: 1;
          transform: translateY(0);
        }
      }

      .status {
        display: inline-flex;
        align-items: center;
        gap: 9px;

        margin-bottom: 24px;

        font-size: 10px;
        font-weight: 700;
        letter-spacing: 0.24em;
        text-transform: uppercase;

        color: #aaa7a0;
      }

      .status-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;

        background: #dedbd3;

        box-shadow:
          0 0 12px rgba(255, 255, 255, 0.6);
      }

      h1 {
        margin: 0;

        font-family: 'Manrope', sans-serif;
        font-size: clamp(30px, 4vw, 54px);
        font-weight: 500;

        letter-spacing: -0.04em;

        color: #f2f0eb;
      }

      .tagline {
        margin: 16px 0 0;

        font-size: clamp(16px, 2vw, 22px);
        font-weight: 400;
        letter-spacing: 0.045em;

        color: #bbb8b1;
      }

      .genre {
        margin-top: 18px;

        font-size: 10px;
        letter-spacing: 0.25em;
        text-transform: uppercase;

        color: #77746f;
      }

      .divider {
        width: 1px;
        height: 56px;

        margin: 34px auto;

        background: linear-gradient(
          to bottom,
          rgba(255, 255, 255, 0),
          rgba(255, 255, 255, 0.4),
          rgba(255, 255, 255, 0)
        );
      }

      .demo {
        width: min(620px, 100%);

        padding: 38px 35px;

        border: 1px solid rgba(255, 255, 255, 0.15);

        background:
          linear-gradient(
            135deg,
            rgba(255, 255, 255, 0.055),
            rgba(255, 255, 255, 0.015)
          );

        backdrop-filter: blur(10px);

        position: relative;
        overflow: hidden;
      }

      .demo::before {
        content: '';

        position: absolute;

        width: 260px;
        height: 260px;

        right: -150px;
        top: -150px;

        border-radius: 50%;

        background: rgba(255, 255, 255, 0.05);
        filter: blur(40px);

        pointer-events: none;
      }

      .eyebrow {
        font-size: 10px;
        font-weight: 700;

        letter-spacing: 0.27em;
        text-transform: uppercase;

        color: #8f8c86;
      }

      .demo h2 {
        margin: 13px 0 10px;

        font-family: 'Manrope', sans-serif;

        font-size: clamp(29px, 5vw, 47px);
        line-height: 1;

        letter-spacing: -0.045em;
      }

      .demo p {
        max-width: 480px;

        margin: 0 auto 27px;

        font-size: 14px;
        line-height: 1.8;

        color: #aaa7a0;
      }

      .demo-button {
        display: inline-flex;

        align-items: center;
        justify-content: center;

        min-width: 220px;

        padding: 17px 25px;

        border: 1px solid #e0ddd5;

        background: #e0ddd5;

        color: #0b0b0c;

        font-size: 11px;
        font-weight: 700;

        letter-spacing: 0.18em;
        text-transform: uppercase;

        transition:
          background 0.25s ease,
          color 0.25s ease,
          transform 0.25s ease;
      }

      .demo-button:hover {
        background: transparent;

        color: #fff;

        transform: translateY(-2px);
      }

      .demo-note {
        display: block;

        margin-top: 15px;

        font-size: 10px;
        letter-spacing: 0.1em;

        color: #66635f;
      }

      footer {
        padding: 25px 25px 30px;

        display: flex;
        align-items: center;
        justify-content: center;

        font-size: 9px;
        letter-spacing: 0.18em;
        text-transform: uppercase;

        color: #55524e;
      }

      @media (max-width: 650px) {
        .hero {
          padding-top: 30px;
          padding-bottom: 50px;
        }

        .logo-window {
          width: 96vw;
          margin-bottom: 12px;
        }

        .status {
          margin-top: 5px;
        }

        .demo {
          padding: 32px 22px;
        }

        .genre {
          line-height: 2;
        }
      }
    </style>
  </head>

  <body>
    <div class="page">
      <main class="hero">

        <!-- VESSYL LOGO -->
        <div class="logo-window">
          <img
            src="/vessyl-logo.jpeg"
            alt="VESSYL logo"
          />
        </div>

        <!-- COMING SOON -->
        <div class="status">
          <span class="status-dot"></span>
          Independent Electronic Label · Coming Soon
        </div>

        <!-- MAIN MESSAGE -->
        <h1>A Place Where Sound Takes You.</h1>

        <p class="tagline">
          A new home for underground sound.
        </p>

        <div class="genre">
          Minimal &nbsp;·&nbsp; Tech House &nbsp;·&nbsp; Techno
        </div>

        <div class="divider"></div>

        <!-- DEMO SUBMISSION -->
        <section class="demo">
          <div class="eyebrow">
            Demo Submissions
          </div>

          <h2>Send us your sound.</h2>

          <p>
            VESSYL is currently listening for original,
            unreleased music from producers pushing
            minimal, tech house and forward-thinking
            electronic sound.
          </p>

          <a
            class="demo-button"
            href={`mailto:${demoEmail}?subject=VESSYL%20Demo%20Submission`}
          >
            Submit a Demo ↗
          </a>

          <span class="demo-note">
            Private SoundCloud links preferred.
          </span>
        </section>

      </main>

      <footer>
        © {new Date().getFullYear()} VESSYL
      </footer>
    </div>
  </body>
</html>
