---
// VESSYL Records — standalone Astro homepage.
// Replace the placeholder email and social links before publishing.
const label = 'VESSYL';
const contactEmail = 'YOUR_EMAIL@example.com';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#101014" />
    <meta name="description" content="VESSYL Records. A place where sound takes you. Independent underground electronic music." />
    <title>VESSYL Records — A Place Where Sound Takes You</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <style>
      :root{font-family:'DM Sans',sans-serif;color:#e9e7e2;background:#101014;font-synthesis:none}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0}a{color:inherit;text-decoration:none}button{font:inherit}.shell{width:min(1180px,calc(100% - 48px));margin:auto}header{position:relative;z-index:2;border-bottom:1px solid #ffffff20;background:#101014}nav{display:flex;align-items:center;justify-content:space-between;min-height:88px;gap:20px}.wordmark{font-family:Manrope,sans-serif;font-weight:800;letter-spacing:.23em;font-size:20px}.navlinks{display:flex;gap:30px;font-size:12px;letter-spacing:.16em;text-transform:uppercase;color:#bbb8b1}.navlinks a:hover,.textlink:hover{color:white}.hero{position:relative;min-height:670px;display:flex;align-items:center;overflow:hidden;background:radial-gradient(ellipse at 75% 40%,#393735 0%,#202023 36%,#101014 75%)}.hero:before{content:'';position:absolute;inset:0;background:repeating-linear-gradient(90deg,transparent 0,transparent 110px,#ffffff06 111px,#ffffff06 112px);pointer-events:none}.hero-inner{position:relative;z-index:1;padding:110px 0}.eyebrow{font-size:11px;font-weight:700;letter-spacing:.28em;text-transform:uppercase;color:#bdb8b0}.hero h1{font-family:Manrope,sans-serif;font-size:clamp(76px,16vw,205px);font-weight:800;letter-spacing:-.075em;line-height:.95;margin:35px 0 20px;color:#f0eee9}.hero h1 span{display:block}.hero p{font-size:clamp(17px,2.2vw,25px);letter-spacing:.06em;color:#c5c1b9;margin:30px 0 40px}.cta{display:inline-flex;align-items:center;justify-content:center;padding:17px 27px;border:1px solid #d6d1c7;background:#d6d1c7;color:#111;font-size:12px;font-weight:700;letter-spacing:.16em;text-transform:uppercase;transition:.2s}.cta:hover{background:transparent;color:#fff}.hero-mark{position:absolute;right:-2%;top:10%;font-family:Manrope,sans-serif;font-size:min(55vw,720px);font-weight:800;line-height:1;color:#ffffff08;transform:scaleX(.8);pointer-events:none}.section{padding:105px 0;border-top:1px solid #ffffff1a}.section-heading{display:flex;justify-content:space-between;align-items:end;gap:24px;margin-bottom:40px}.section h2{font-family:Manrope,sans-serif;font-size:clamp(30px,5vw,58px);letter-spacing:-.045em;line-height:1.1;margin:12px 0}.muted{color:#a9a69f;line-height:1.8}.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}.release{border:1px solid #ffffff25;background:#19191c}.art{aspect-ratio:1;display:grid;place-items:center;position:relative;overflow:hidden;background:linear-gradient(135deg,#56534e,#242427 55%,#0d0d0f)}.art:after{content:'';position:absolute;width:65%;height:65%;border:22px solid #d6d1c72b;transform:rotate(45deg)}.art b{font-family:Manrope,sans-serif;z-index:1;font-size:clamp(24px,4vw,48px);letter-spacing:.18em;color:#e5e0d5}.release-body{padding:22px}.release h3{margin:0 0 7px;font-size:17px}.release small{color:#aaa69e}.statement{max-width:850px;font-family:Manrope,sans-serif;font-size:clamp(25px,4vw,45px);font-weight:600;letter-spacing:-.04em;line-height:1.3}.panel{padding:40px;border:1px solid #ffffff2c;background:#1b1b1e}.panel h3{font-size:25px;margin:0 0 10px}.panel p{max-width:670px}.textlink{display:inline-block;margin-top:20px;font-size:12px;font-weight:700;letter-spacing:.17em;text-transform:uppercase;border-bottom:1px solid #8b8780;padding-bottom:8px}footer{border-top:1px solid #ffffff25;padding:38px 0;color:#aaa69f;font-size:12px}.footerinner{display:flex;justify-content:space-between;gap:18px;flex-wrap:wrap}.footerinner a{text-decoration:underline;text-underline-offset:4px}@media(max-width:700px){.shell{width:min(100% - 36px,1180px)}nav{min-height:75px;align-items:flex-start;padding:25px 0;flex-direction:column}.navlinks{gap:17px;font-size:10px;flex-wrap:wrap}.hero{min-height:530px}.hero-inner{padding:85px 0}.hero h1{font-size:clamp(66px,17vw,120px)}.hero-mark{right:-20%;top:25%}.section{padding:70px 0}.grid{grid-template-columns:1fr}.section-heading{display:block}.panel{padding:25px}}
    </style>
  </head>
  <body>
    <header><nav class="shell" aria-label="Main navigation"><a class="wordmark" href="#home">{label}</a><div class="navlinks"><a href="#releases">Releases</a><a href="#about">About</a><a href="#artists">Artists</a><a href="#demos">Demos</a></div></nav></header>
    <main>
      <section class="hero" id="home"><div class="hero-mark" aria-hidden="true">V</div><div class="shell hero-inner"><div class="eyebrow">Independent electronic music label / Est. 2026</div><h1>VESSYL<span>RECORDS.</span></h1><p>A Place Where Sound Takes You.</p><a class="cta" href="#releases">Explore the sound ↗</a></div></section>
      <section class="section" id="releases"><div class="shell"><div class="section-heading"><div><div class="eyebrow">The catalog</div><h2>Latest releases.</h2></div><p class="muted">Our first releases are on the way.</p></div><div class="grid"><article class="release"><div class="art"><b>V / 001</b></div><div class="release-body"><h3>First Transmission</h3><small>Upcoming release · Details to be announced</small></div></article><article class="release"><div class="art"><b>V / 002</b></div><div class="release-body"><h3>Next Chapter</h3><small>Future release · Details to be announced</small></div></article><article class="release"><div class="art"><b>V / 003</b></div><div class="release-body"><h3>More to Come</h3><small>Future release · Details to be announced</small></div></article></div><p class="muted" style="font-size:12px;margin-top:20px">Concept artwork and placeholder titles — not published tracks.</p></div></section>
      <section class="section" id="about"><div class="shell"><div class="eyebrow">The philosophy</div><h2>Not just a label.<br />A destination.</h2><p class="statement">A home for hypnotic rhythms, deep grooves, and the moments when the music takes over.</p><p class="muted">VESSYL is an independent home for underground house, minimal tech, and forward-thinking dance music. Built around sound, movement, and connection.</p></div></section>
      <section class="section" id="artists"><div class="shell"><div class="eyebrow">The collective</div><h2>Artists.</h2><div class="panel"><h3>New voices. Distinct sounds.</h3><p class="muted">We're building the VESSYL artist family. Our roster will be announced here as releases take shape.</p></div></div></section>
      <section class="section" id="demos"><div class="shell"><div class="eyebrow">Send us your sound</div><h2>Demo submissions.</h2><div class="panel"><h3>Make yourself heard.</h3><p class="muted">Producing underground house or minimal tech? We're interested in hearing original, unreleased music. Replace the placeholder email in this page's code before sharing demos publicly.</p><a class="textlink" href={`mailto:${contactEmail}?subject=VESSYL%20Demo%20Submission`}>Submit a demo ↗</a></div></div></section>
    </main>
    <footer><div class="shell footerinner"><span>© {new Date().getFullYear()} VESSYL RECORDS. ALL RIGHTS RESERVED.</span><span>A PLACE WHERE SOUND TAKES YOU.</span></div></footer>
  </body>
</html>
---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<h1>🧑‍🚀 Welcome to Vessyl Records!</h1>
			<p>
				Welcome to the official <a href="https://astro.build/">Astro</a> blog starter template. This
				template serves as a lightweight, minimally-styled starting point for anyone looking to build
				a personal website, blog, or portfolio with Astro.
			</p>
			<p>
				This template comes with a few integrations already configured in your
				<code>astro.config.mjs</code> file. You can customize your setup with
				<a href="https://astro.build/integrations">Astro Integrations</a> to add tools like Tailwind,
				React, or Vue to your project.
			</p>
			<p>Here are a few ideas on how to get started with the template:</p>
			<ul>
				<li>Edit this page in <code>src/pages/index.astro</code></li>
				<li>Edit the site header items in <code>src/components/Header.astro</code></li>
				<li>Add your name to the footer in <code>src/components/Footer.astro</code></li>
				<li>Check out the included blog posts in <code>src/content/blog/</code></li>
				<li>Customize the blog post page layout in <code>src/layouts/BlogPost.astro</code></li>
			</ul>
			<p>
				Have fun! If you get stuck, remember to <a href="https://docs.astro.build/"
					>read the docs
				</a> or <a href="https://astro.build/chat">join us on Discord</a> to ask questions.
			</p>
			<p>
				Looking for a blog template with a bit more personality? Check out <a
					href="https://github.com/Charca/astro-blog-template"
					>astro-blog-template
				</a> by <a href="https://twitter.com/Charca">Maxi Ferreira</a>.
			</p>
		</main>
		<Footer />
	</body>
</html>
